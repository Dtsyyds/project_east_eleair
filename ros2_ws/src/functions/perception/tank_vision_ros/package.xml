<?xml version="1.0"?>
<package format="3">
  <name>tank_vision_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy wrapper for the tank vision inspection core.</description>
  <maintainer email="maintainer@example.com">Tank Vision Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>ament_index_python</depend>
  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tank_vision_core</depend>
  <depend>tank_vision_interfaces</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
