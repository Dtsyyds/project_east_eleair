# Local Git repositories are retained on disk; their source is vendored here.
.git/

# Python environments and caches
.venv*/
.runtime/
venv/
core_env*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ROS/CMake build, installation and runtime output
build/
build_*/
install/
install_*/
log/
log_*/
output/
output_*/
test_results*/
/.runtime/*/rollback/
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so
*.so.*
*.log
*.log.*
compile_commands.json
Testing/Temporary/

