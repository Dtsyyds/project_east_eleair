@@ -0,0 +1,79 @@
+from dataclasses import replace
+import pytest
+from duct_robot_tracking.core import TrackingCore, TrackingConfig, Observation
+
+BASE=100_000_000_000
+
+def observation(t,seq,**kw):
+    return replace(Observation(BASE+round(t*1e9),seq,'camera_optical_frame',True,-.1,0.,.9),**kw)
+
+def running():
+    c=TrackingCore(TrackingConfig(loss_grace_s=.25,confidence_hysteresis=.04,min_confidence=.2))
+    c.receive(observation(0,1),0,BASE);assert c.enable(0,BASE)[0]
+    for i in range(1,5):
+        t=i*.05;c.receive(observation(t,i+1),t,BASE+round(t*1e9));c.tick(t,BASE+round(t*1e9))
+    return c
+
+
+def test_dropouts_decelerate_without_false_refresh_and_resume_smoothly():
+    c=running();speed=c.linear;turn=c.angular
+    c.receive(observation(.25,6,valid=False),.25,BASE+250_000_000)
+    a=c.tick(.25,BASE+250_000_000)
+    assert 0<a.linear<speed and a.angular/turn==pytest.approx(a.linear/speed)
+    assert c.received_at==.2 and c.observation.frame_seq==5
+    c.receive(observation(.3,7),.3,BASE+300_000_000)
+    b=c.tick(.3,BASE+300_000_000)
+    assert b.linear>0 and abs(b.linear-a.linear)<=c.config.max_linear_acceleration*.05+1e-9
+    assert c.enabled
+
+
+def test_repeated_invalid_frames_do_not_extend_motion_and_recover_from_zero():
+    c=running()
+    for i in range(5,30):
+        t=i*.05;c.receive(observation(t,i+1,valid=False),t,BASE+round(t*1e9))
+        out=c.tick(t,BASE+round(t*1e9))
+        if t>=.45: assert out.linear==out.angular==0
+    assert c.enabled and c.received_at==.2
+
+
+def test_confidence_hysteresis_and_low_confidence_pause_not_latch():
+    c=running()
+    assert c.receive(observation(.25,6,confidence=.18),.25,BASE+250_000_000)
+    assert not c.receive(observation(.3,7,confidence=.1),.3,BASE+300_000_000)
+    assert c.enabled and c.invalid_frame_count==1
+    assert c.receive(observation(.35,8,confidence=.3),.35,BASE+350_000_000)
+    assert c.enabled
+    c.stop('operator_stop')
+    c.receive(observation(.4,9,confidence=.18),.4,BASE+400_000_000)
+    assert not c.enable(.4,BASE+400_000_000)[0]
+
+
+@pytest.mark.parametrize('reason',['external_inhibit','driver_unavailable','remote_control_active'])
+def test_hard_stop_overrides_grace(reason):
+    c=running();c.receive(observation(.25,6,valid=False),.25,BASE+250_000_000)
+    out=c.tick(.25,BASE+250_000_000,reason)
+    assert out.linear==out.angular==0 and not c.enabled
+
+
+def test_no_motion_after_last_valid_image_expires_even_with_longer_grace():
+    c=running();c.receive(observation(.25,6,valid=False),.25,BASE+250_000_000)
+    for i in range(6,10):
+        t=i*.05;c.receive(observation(t,i+1,valid=False),t,BASE+round(t*1e9))
+        out=c.tick(t,BASE+round(t*1e9))
+    assert out.linear==out.angular==0
+
+
+def test_dropout_frequency_no_longer_forces_zero_every_other_frame():
+    c=running();zeros=0
+    for i in range(5,25):
+        t=i*.05;c.receive(observation(t,i+1,valid=i%2==0),t,BASE+round(t*1e9))
+        zeros+=c.tick(t,BASE+round(t*1e9)).linear==0
+    assert zeros==0
+
+
+def test_low_confidence_cannot_mask_invalid_coordinates():
+    c=running()
+    c.receive(observation(.25,6,confidence=.1,lateral=2.),.25,BASE+250_000_000)
+    out=c.tick(.25,BASE+250_000_000)
+    assert not c.enabled and c.reason=='lateral_error_out_of_range'
+    assert out.linear==out.angular==0
