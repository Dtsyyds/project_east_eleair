+    def pause_visual(self, obs, mono):
+        """Only an opt-in short dropout can decelerate from the last measured command."""
+        self.last_frame_received, self.last_frame_stamp = mono, obs.stamp_ns
+        self.invalid_frame_count += 1
+        if self.enabled:
+            if self.invalid_since is None:
+                self.invalid_since = mono
+                self.loss_linear, self.loss_angular = self.linear, self.angular
+            self.reason = 'vision_coasting' if self.loss_scale(mono) > 0 else 'vision_paused'
+            if self.reason == 'vision_paused':
+                self.linear = self.angular = 0.0
+            self.reset_pid()
+        elif self.observation is None and self.reason == 'waiting_for_enable':
+            self.reason = 'vision_invalid'
+
+    def loss_scale(self, mono):
+        if self.received_at is None or self.config.loss_grace_s <= 0:
+            return 0.
+        age = mono-self.received_at
+        return max(0., 1.-age/self.config.loss_grace_s) if age >= 0 else 0.
